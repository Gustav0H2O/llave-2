{
  "name": "fueltech-master",
  "version": "1.0.0",
  "description": "Gestión, diagnóstico y consulta técnica de módulos y pilas (bombas) de gasolina",
  "main": "server-pg.js",
  "scripts": {
    "seed": "node seed.js",
    "start": "node server-pg.js",
    "og": "node og-gen.js",
    "test": "node --test test/*.test.js test/unit/*.test.js test/qa/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:qa": "node --test test/qa/*.test.js",
    "test:api": "node --test test/api.test.js test/business.test.js",
    "test:e2e": "node --test test/e2e.suite.js",
    "test:cobertura": "node --test --experimental-test-coverage test/unit/*.test.js test/qa/*.test.js test/*.test.js",
    "robots": "node test/robots/index.js",
    "robots:rapido": "node test/robots/index.js --rapido",
    "robots:informe": "node test/robots/reporte.js",
    "robots:registro": "node test/robots/registro.js",
    "robots:aislamiento": "node test/robots/aislamiento.js",
    "robots:fuzz": "node test/robots/fuzz.js",
    "robots:carga": "node test/robots/carga.js",
    "robots:recorrido": "node test/robots/recorrido.js",
    "robots:jornada": "node test/robots/jornada.js",
    "robots:interfaz": "node test/robots/interfaz.js",
    "guard": "node scripts/guard.js",
    "guard:rapido": "node scripts/guard.js --fast",
    "metrics": "node scripts/metrics.js",
    "metrics:aceptar": "node scripts/metrics.js --accept",
    "verify": "node scripts/qa.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@libsql/client": "^0.17.4",
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "htm": "^3.1.1",
    "lucide": "^0.468.0",
    "morgan": "^1.11.0",
    "pg": "^8.22.0",
    "puppeteer-core": "^25.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "puppeteer": "^25.5.0"
  }
}
