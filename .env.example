# ============================================================
# FuelTech Master — Configuración de entorno
# Copia este archivo a .env y completa los valores.
# .env está en .gitignore (no se sube a git).
# ============================================================

# --- Base de datos: Turso (recomendado, datos persistentes en la nube) ---
# URL de la base (formato libsql://tu-base.turso.io) y token de acceso.
# Se obtienen en https://console.turso.tech → tu base → "Create token".
TURSO_URL=
TURSO_AUTH_TOKEN=

# Forzar SQLite local aun con NODE_ENV=production (desaconsejado en hosts serverless/cloud por pérdida de datos efímeros)
ALLOW_LOCAL_SQLITE_PROD=

# --- Alternativa: PostgreSQL (si en algún momento usas Render u otro host con DATABASE_URL) ---
# DATABASE_URL=
# Ruta al certificado CA para verificar TLS de PostgreSQL (obligatorio en
# producción salvo hosts .internal, que van sin ssl). Sin él el arranque falla
# cerrado en producción; en desarrollo se usa el CA del sistema.
# PG_CA_PATH=
# Tope de conexiones del pool de PostgreSQL (por defecto 10).
# PG_POOL_MAX=10

# --- Puerto del servidor ---
PORT=3000

# --- Panel de administración (/admin) ---
# Si está vacío, el panel queda desactivado.
ADMIN_PASSWORD=

# --- Avisos automáticos de Donaciones (Google Drive, Apps Script, Discord, Webhooks) ---
# URL de webhook a donde se despachan alertas inmediatas de cada aporte registrado.
DONATION_WEBHOOK_URL=

# --- Envío de correo (verificación de la cuenta del taller) ---
# Va por HTTP a Resend para no añadir una dependencia SMTP. Sin clave el flujo
# SIGUE FUNCIONANDO: el servidor devuelve el enlace de confirmación en la
# respuesta y lo escribe en el log, útil en desarrollo.
# Ya NO es imprescindible: las cuentas nuevas nacen con Google, que verifica el
# correo por su cuenta (email_verified = 1) y no pasa por aquí. Solo sirve para
# confirmar el correo de cuentas antiguas creadas con contraseña.
RESEND_API_KEY=
MAIL_FROM=FuelTech Master <onboarding@resend.dev>

# Dominio público: de aquí sale el enlace de confirmación que va en el correo.
# Si apunta a otro sitio, el enlace lleva al sitio equivocado.
BASE_URL=https://fueltech-master.onrender.com

# --- Modo mantenimiento ---
# Con MAINTENANCE=1 el sitio entero responde 503 con su pantalla propia ("En
# mantenimiento", lib/errores.js) en vez de quedarse a medias durante un
# despliegue. Se dejan pasar /healthz —si respondiera 503 el host creería el
# proceso muerto y lo reiniciaría en bucle— y los estáticos, o la propia
# pantalla saldría sin estilos ni ilustración. Vacío o 0 = sitio normal.
MAINTENANCE=

# --- Asistente de IA vía NVIDIA NIM (build.nvidia.com) ---
# Es la PRIMERA opción: si esta clave está puesta, el chat la usa y OpenRouter
# y Gemini quedan como respaldo. Se saca de build.nvidia.com (plan gratuito con
# créditos) y empieza por "nvapi-". Va como SECRETO del host, nunca en el repo:
# este archivo es el ejemplo, el .env real no se sube.
NVIDIA_API_KEY=
# Cadena de modelos en orden de preferencia (separados por coma). Si el primero
# está saturado (429) se prueba el siguiente. Tienen que ser ids REALES y
# VIGENTES del catálogo de NIM: uno inventado —o uno retirado— no da error de
# configuración (misma trampa que GEMINI_MODEL, AGENTS.md §4.10). NVIDIA jubila
# modelos: `meta/llama-3.3-70b-instruct` murió el 2026-08-26 y responde 410.
# Para ver los vivos:  curl https://integrate.api.nvidia.com/v1/models
# Evita los nemotron «reasoning»: meten su cadena de pensamiento en la respuesta.
NVIDIA_MODELS=google/gemma-4-31b-it,mistralai/mistral-large-2-instruct,google/gemma-3-12b-it

# --- Asistente de IA (chat de diagnóstico) ---
# Clave de Google AI Studio. Sin ella el chat responde error, el resto del sitio
# funciona igual. Configúrala como SECRETO en el panel del host, nunca aquí.
GEMINI_API_KEY=
# Identificador del modelo. Tiene que ser un id REAL de Google: uno inventado
# (p. ej. "gemini-3.5-flash") hace que el chat devuelva 502 sin explicación.
GEMINI_MODEL=gemini-1.5-flash

# --- Asistente de IA vía Groq (console.groq.com) — 14,400 peticiones/día GRATIS ---
# Es la PRIMERA opción: si esta clave está puesta, el chat usa Groq. Regístrate
# en https://console.groq.com, crea una key y pégala como SECRETO del host.
GROQ_API_KEY=
# Cadena de modelos en orden de preferencia (separados por coma). Si el primero
# está saturado (429) se prueba el siguiente. Ver modelos activos:
# curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer TU_KEY"
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b,qwen/qwen3.6-27b

# --- Asistente de IA vía OpenRouter (respaldo con modelos gratis) ---
# Si se configura esta clave (como SECRETO del host, igual que la anterior),
# el chat usa OpenRouter cuando Groq no está disponible. Elige modelos con
# sufijo ":free" para no generar costo; catálogo actual: openrouter.ai/models
OPENROUTER_API_KEY=
# Cadena de modelos gratis en orden de preferencia (separados por coma). Si el
# primero está saturado (429) se prueba el siguiente automáticamente. Los
# gemma responden limpio en español; evita los «reasoning» gratuitos: mezclan
# su cadena de pensamiento en inglés dentro de la respuesta.
OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free

# --- Google Sign-In (OAuth 2.0) ---
# ES LA ÚNICA VÍA DE ALTA de talleres: en producción POST /api/auth/register
# responde 403 (el alta se crea con Google, cuyo correo ya viene verificado, así
# que no depende de tener Resend configurado). El login con contraseña SIGUE
# funcionando para las cuentas que ya la tienen, y una cuenta con contraseña del
# mismo correo también puede entrar con Google (se conserva su contraseña).
# SI ESTAS DOS VARIABLES FALTAN EN PRODUCCIÓN, NADIE PUEDE CREARSE UNA CUENTA.
# Permite a los usuarios iniciar sesión con su cuenta de Google. Configura un
# proyecto en https://console.cloud.google.com > APIs & Services > Credentials
# > Create OAuth 2.0 Client ID (tipo Web application). Agrega el redirect URI:
# https://TU_DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI de callback (auto-detectado en producción si se deja vacío)
GOOGLE_REDIRECT_URI=
# Extremos de Google. SOLO para pruebas: permiten apuntar a un doble local y
# ejercitar el callback entero (state, correo verificado, alta/reclamo y sesión)
# sin red ni cuenta real. En producción y en local deben quedar SIN TOCAR.
# GOOGLE_TOKEN_URL=
# GOOGLE_USERINFO_URL=

# --- Límites del chat (protegen la cuota gratuita) ---
# Consultas por dispositivo al día / techo por red o IP / techo GLOBAL de todo
# el sitio. El global existe porque los modelos :free tienen tope por CUENTA:
# aunque llegue tráfico anómalo, el cupo del día no se quema en una hora.
CHAT_DAILY_LIMIT=3
CHAT_IP_CEILING=30
CHAT_GLOBAL_CEILING=150
# Tope de espera (en milisegundos) de cada llamada a un proveedor de IA (2.41).
# Si el proveedor no contesta en ese tiempo se corta con AbortController y el
# chat responde 504 con un mensaje accionable, en vez de dejar al mecánico
# esperando para siempre. Rango válido: 1000..120000.
CHAT_TIMEOUT_MS=30000

# --- Analítica y anuncios ---
# Google Analytics 4. Vacío = desactivado (y no se abre la CSP para su dominio).
GA_MEASUREMENT_ID=G-MXGS03FKB0
# Google AdSense, formato ca-pub-0000000000000000. Vacío = desactivado: no se
# inyecta el script, no se abre la CSP y /ads.txt responde 404.
ADSENSE_CLIENT=

# --- Páginas legales ---
# Aparecen en aviso de privacidad, términos y contacto.
CONTACT_EMAIL=
SITE_OWNER=FuelTech Master

# --- Contador de visitas ---
# Sal para el hash irreversible de visitante (IP+navegador+día; no se guardan IPs).
# OBLIGATORIA en producción (NODE_ENV=production): el proceso NO arranca sin
# ella, porque con una sal nueva en cada reinicio el mismo visitante se cuenta
# de nuevo y el contador deja de significar nada. En local o en pruebas, si se
# deja vacía, se genera una al azar para no estorbar.
VISIT_SALT=

# --- Generación de imágenes Open Graph (npm run og) ---
# Ruta a un Chrome/Edge del sistema, para no depender del Chrome de Puppeteer.
# Si se deja vacío, el script busca en las rutas habituales de Windows y Linux.
CHROME_PATH=

# --- Ajustes de despliegue (normalmente no hace falta tocarlos) ---
# NODE_ENV=production activa HSTS, upgrade-insecure-requests y cookies seguras.
# NODE_ENV=production
# TRUST_PROXY=0 desactiva la confianza en X-Forwarded-For (solo para pruebas
# locales; detrás de Render/Cloudflare debe quedar activada, que es el valor por
# defecto, o el rate limit vería a todos los visitantes como una sola IP).
# TRUST_PROXY=1
# TRUST_PROXY_CIDR es el CIDR del proxy de confianza para Express (trust proxy).
# Por defecto 127.0.0.1/8 (solo loopback). Detrás de Render/Cloudflare usa el
# CIDR de tu proxy; con TRUST_PROXY=0 se desactiva por completo.
# TRUST_PROXY_CIDR=127.0.0.1/8
# AUTH_LIMIT ajusta el límite de intentos de auth/register por minuto (por defecto 20; 2000 en test).
# AUTH_LIMIT=20
