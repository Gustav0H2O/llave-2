# ============================================================
# FuelTech Master — Configuración de entorno
# Copia este archivo a .env y completa los valores.
# .env está en .gitignore (no se sube a git).
# ============================================================

# --- Base de datos: Turso (recomendado, datos persistentes en la nube) ---
# URL de la base (formato libsql://tu-base.turso.io) y token de acceso.
# Se obtienen en https://console.turso.tech → tu base → "Create token".
TURSO_URL=
TURSO_AUTH_TOKEN=

# --- Alternativa: PostgreSQL (si en algún momento usas Render u otro host con DATABASE_URL) ---
# DATABASE_URL=

# --- Puerto del servidor ---
PORT=3000

# --- Panel de administración (/admin) ---
# Si está vacío, el panel queda desactivado.
ADMIN_PASSWORD=

# --- Envío de correo (verificación de la cuenta del taller) ---
# Va por HTTP a Resend para no añadir una dependencia SMTP. Sin clave el flujo
# SIGUE FUNCIONANDO: el servidor devuelve el enlace de confirmación en la
# respuesta y lo escribe en el log, útil en desarrollo. En producción, sin clave,
# el enlace NO se devuelve y nadie puede confirmar su correo — configúrala.
RESEND_API_KEY=
MAIL_FROM=FuelTech Master <onboarding@resend.dev>

# Dominio público: de aquí sale el enlace de confirmación que va en el correo.
# Si apunta a otro sitio, el enlace lleva al sitio equivocado.
BASE_URL=https://fueltech-master.onrender.com

# --- Asistente de IA (chat de diagnóstico) ---
# Clave de Google AI Studio. Sin ella el chat responde error, el resto del sitio
# funciona igual. Configúrala como SECRETO en el panel del host, nunca aquí.
GEMINI_API_KEY=
# Identificador del modelo. Tiene que ser un id REAL de Google: uno inventado
# (p. ej. "gemini-3.5-flash") hace que el chat devuelva 502 sin explicación.
GEMINI_MODEL=gemini-1.5-flash

# --- Analítica y anuncios ---
# Google Analytics 4. Vacío = desactivado (y no se abre la CSP para su dominio).
GA_MEASUREMENT_ID=G-MXGS03FKB0
# Google AdSense, formato ca-pub-0000000000000000. Vacío = desactivado: no se
# inyecta el script, no se abre la CSP y /ads.txt responde 404.
ADSENSE_CLIENT=

# --- Páginas legales ---
# Aparecen en aviso de privacidad, términos y contacto.
CONTACT_EMAIL=
SITE_OWNER=FuelTech Master

# --- Contador de visitas ---
# Sal para el hash irreversible de visitante (IP+navegador+día; no se guardan IPs).
# Si se deja vacío se genera una al azar en cada arranque, y entonces un mismo
# visitante se cuenta de nuevo tras cada reinicio. En producción, fíjala.
VISIT_SALT=

# --- Generación de imágenes Open Graph (npm run og) ---
# Ruta a un Chrome/Edge del sistema, para no depender del Chrome de Puppeteer.
# Si se deja vacío, el script busca en las rutas habituales de Windows y Linux.
CHROME_PATH=

# --- Ajustes de despliegue (normalmente no hace falta tocarlos) ---
# NODE_ENV=production activa HSTS, upgrade-insecure-requests y cookies seguras.
# NODE_ENV=production
# TRUST_PROXY=0 desactiva la confianza en X-Forwarded-For (solo para pruebas
# locales; detrás de Render/Cloudflare debe quedar activada, que es el valor por
# defecto, o el rate limit vería a todos los visitantes como una sola IP).
# TRUST_PROXY=1
